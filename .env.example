# API local
TRAZIA_HOST=127.0.0.1
TRAZIA_PORT=8000
TRAZIA_DATA=data
TRAZIA_QUEUE=process
TRAZIA_REDIS_URL=redis://localhost:6379/0
# Opcional; sin esta variable se usa SQLite en TRAZIA_DATA.
# TRAZIA_DATABASE_URL=postgresql+psycopg://trazia:trazia-local-demo@localhost/trazia

# Ollama: servicio local, sin enviar documentos a terceros.
TRAZIA_OLLAMA_URL=http://127.0.0.1:11434
TRAZIA_OLLAMA_MODEL=qwen3-vl:4b-instruct

# Demo local de Docker Compose; no es una credencial de producción.
TRAZIA_POSTGRES_PASSWORD=trazia-local-demo
TRAZIA_WORKER_CONCURRENCY=2

# En web/.env.local; dejar sin definir para conservar la demo offline.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
