# API local
TRAZIA_HOST=127.0.0.1
TRAZIA_PORT=8000
# Vacío conserva localhost/127.0.0.1 en 3000,3100,3200,3300,3310,3311.
# Para esta sesión: http://localhost:3120,http://127.0.0.1:3120
TRAZIA_CORS_ORIGINS=
# Por defecto: generated/correcciones/correcciones.jsonl en la raíz del repo.
# En Docker se usa /data/correcciones/correcciones.jsonl, dentro del volumen persistente.
# TRAZIA_CORRECTIONS_FILE=generated/correcciones/correcciones.jsonl
TRAZIA_DATA=data
TRAZIA_QUEUE=process
TRAZIA_REDIS_URL=redis://localhost:6379/0
# Opcional; sin esta variable se usa SQLite en TRAZIA_DATA.
# TRAZIA_DATABASE_URL=postgresql+psycopg://trazia:trazia-local-demo@localhost/trazia

# Ollama: servicio local, sin enviar documentos a terceros.
TRAZIA_OLLAMA_URL=http://127.0.0.1:11434
TRAZIA_OLLAMA_MODEL=qwen3-vl:4b-instruct

# Demo local de Docker Compose; no es una credencial de producción.
TRAZIA_POSTGRES_PASSWORD=trazia-local-demo
TRAZIA_WORKER_CONCURRENCY=2

# Trabajos offline: reutiliza resultados validados en el almacén; un fallo devuelve HTTP 409.
# Preparar la caché con trabajos online. Visión y copiloto conservan además sus cachés.
TRAZIA_OFFLINE=0
# Datos sintéticos para POST /estudio, relativos al proceso o ruta absoluta local.
TRAZIA_STUDY_DATA=generated/synthetic_v2

# En web/.env.local; dejar sin definir para conservar la demo offline.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Calibración por trabajo: un cambio de SHA invalida la caché offline.
# Local: generated/calibration/calibracion.json. "off" la desactiva.
# En Compose, ruta dentro del volumen compartido por API y workers:
# TRAZIA_CALIBRATION=/data/calibration/calibracion.json
# Proponer un reajuste CPU (no activa el resultado automáticamente):
# uv run python -m bench.recalibrar --almacen generated/stack-main --correcciones generated/correcciones/correcciones.jsonl
