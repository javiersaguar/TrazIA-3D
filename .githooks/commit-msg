#!/bin/sh
# Rechaza commits con coautores o firmas de herramientas.
# Activar una vez por clon: git config core.hooksPath .githooks
msg_file="$1"

if grep -Eiq '^[[:space:]]*co-authored-by:' "$msg_file"; then
  echo "ERROR: en este repositorio no se permiten líneas Co-authored-by." >&2
  echo "Los únicos autores son los cuatro miembros del equipo." >&2
  exit 1
fi

if grep -Eiq 'generated with|generated by|noreply@anthropic\.com|noreply@openai\.com|copilot@github\.com' "$msg_file"; then
  echo "ERROR: el mensaje contiene una firma de herramienta. Quítala y vuelve a hacer el commit." >&2
  exit 1
fi

exit 0
