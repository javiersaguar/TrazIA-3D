FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 UV_LINK_MODE=copy TRAZIA_ROOT=/app TRAZIA_DATA=/data TRAZIA_HOST=0.0.0.0 \
    TRAZIA_VISION_CACHE=/data/cache/vision TRAZIA_REGISTRO_ENVIOS=/data/registro_envios.jsonl
WORKDIR /app
RUN pip install --no-cache-dir uv==0.11.30
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --extra api --extra geo --extra ocr --no-dev
COPY examples ./examples
COPY bench ./bench
COPY synthetic ./synthetic
COPY web/public/demo ./web/public/demo
RUN useradd --uid 10001 --create-home trazia && mkdir /data && chown trazia:trazia /data
USER trazia
EXPOSE 8000
CMD [".venv/bin/python", "-m", "trazia.api"]
